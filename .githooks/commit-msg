#!/bin/sh
# Refuse commit messages that don't follow Conventional Commits
# (https://www.conventionalcommits.org): `type(scope)!: description`.
# Enabled by `npm install` (the `prepare` script sets core.hooksPath).

subject=$(grep -v '^#' "$1" | head -n 1)

# Messages git writes itself.
case "$subject" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *) exit 0 ;;
esac

types='feat|fix|perf|refactor|docs|style|test|build|ci|chore|revert'
if printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: [^ ]"; then
  exit 0
fi

cat >&2 <<MSG
✖ Commit message doesn't follow Conventional Commits:

    $subject

  Use  type(scope)!: description   — scope and ! (breaking change) optional
  Types: $(printf '%s' "$types" | sed 's/|/, /g')
  e.g.   feat(areas): add a Broken Items place above the Storage Card
         fix(save): load old saves with a 'time' sidebar deck again
MSG
exit 1
